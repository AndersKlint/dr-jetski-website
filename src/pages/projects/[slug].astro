---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { loadPublicProjectDetails } from '../../projects/astroProjectSource';
import { prepareProjectDetail } from '../../projects/projectDetail';
import type { Project } from '../../projects/Project';
import ProjectDetailView from '../../project-detail-view/ProjectDetailView.astro';
import SiteLayout from '../../site/SiteLayout.astro';
import SenderHead from '../../newsletter/SenderHead.astro';
import SenderForm from '../../newsletter/SenderForm.astro';
import JetAlignAudio from '../../project-detail-view/JetAlignAudio.astro';
import guitarBefore from '../../content/projects/jetalign/guitar-before.webm?url';
import guitarAfter from '../../content/projects/jetalign/guitar-after.webm?url';

interface Props {
  project: Project;
  entry: CollectionEntry<'projects'>;
  privacyHref?: string;
  termsHref?: string;
}

export async function getStaticPaths() {
  const details = await loadPublicProjectDetails();
  return details.map(({ project, entry, privacyEntry, termsEntry }) => ({
    params: { slug: project.slug },
    props: { project, entry, privacyHref: privacyEntry ? `${project.href}/privacy` : undefined, termsHref: termsEntry ? `${project.href}/terms-of-service` : undefined },
  }));
}

const { project, entry, privacyHref, termsHref } = Astro.props as Props;
const { Content } = await render(entry);
const detail = prepareProjectDetail(project);
const isJetAlign = project.slug === 'jetalign';
const isHanScan = project.slug === 'hanscan';
---
<SiteLayout
  title={`${project.displayName} — Dr. Jetski Studios`}
  description={project.description}
  isProjectPage
  image={detail.socialImage}
  imageAlt={detail.socialImageAlt}
>
  <Fragment slot="head">{isJetAlign && <SenderHead />}</Fragment>
  <ProjectDetailView
    project={project}
    downloads={detail.downloads}
    isCompactMedia={detail.isCompactMedia}
    privacyHref={privacyHref}
    termsHref={termsHref}
    isSimplified={isJetAlign || isHanScan || project.slug === 'waytoclip'}
  >
    <Fragment slot="before-downloads">{isJetAlign && <JetAlignAudio beforeSrc={guitarBefore} afterSrc={guitarAfter} />}</Fragment>
    <Fragment slot="after-details">{isJetAlign && <SenderForm />}</Fragment>
    <Content />
  </ProjectDetailView>
</SiteLayout>
