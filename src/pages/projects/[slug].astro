---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { loadPublicProjectDetails } from '../../projects/astroProjectSource';
import { prepareProjectDetail } from '../../projects/projectDetail';
import type { Project } from '../../projects/Project';
import ProjectDetailView from '../../project-detail-view/ProjectDetailView.astro';
import SiteLayout from '../../site/SiteLayout.astro';

interface Props {
  project: Project;
  entry: CollectionEntry<'projects'>;
  privacyHref?: string;
  termsHref?: string;
}

export async function getStaticPaths() {
  const details = await loadPublicProjectDetails();
  return details.map(({ project, entry, privacyEntry, termsEntry }) => ({
    params: { slug: project.slug },
    props: { project, entry, privacyHref: privacyEntry ? `${project.href}/privacy` : undefined, termsHref: termsEntry ? `${project.href}/terms-of-service` : undefined },
  }));
}

const { project, entry, privacyHref, termsHref } = Astro.props as Props;
const { Content } = await render(entry);
const detail = prepareProjectDetail(project);
---
<SiteLayout
  title={`${project.displayName} — Dr. Jetski Studios`}
  description={project.description}
  projectBanner={{ displayName: project.displayName, hasDownloads: detail.hasDownloads }}
  image={detail.socialImage}
  imageAlt={detail.socialImageAlt}
>
  <ProjectDetailView
    project={project}
    downloads={detail.downloads}
    isCompactMedia={detail.isCompactMedia}
    privacyHref={privacyHref}
    termsHref={termsHref}
  >
    <Content />
  </ProjectDetailView>
</SiteLayout>
