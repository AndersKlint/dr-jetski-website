---
import SiteLayout from '../site/SiteLayout.astro';
---
<SiteLayout
  title="Not found — Dr. Jetski Studios"
  description="The requested page could not be found. Browse Dr. Jetski Studios projects or return to the homepage."
  noindex
>
  <main class="not-found" id="main-content">
    <p class="kicker">Off the trail</p>
    <h1>That page drifted away.</h1>
    <p>The page you are looking for does not exist or has moved.</p>
    <nav aria-label="Not found">
      <ul class="not-found-links">
        <li><a href="/">Browse projects</a></li>
        <li><a href="/#about">About/contact</a></li>
      </ul>
    </nav>
  </main>
</SiteLayout>
<style>
  .not-found {
    max-width: var(--measure);
    margin-inline: auto;
    padding: 4rem 1.25rem 3rem;
  }

  .kicker {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ember);
    max-width: none;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .not-found-links {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
</style>
