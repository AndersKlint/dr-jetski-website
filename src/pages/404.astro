---
import SiteLayout from '../site/SiteLayout.astro';
---
<SiteLayout title="Not found — Dr. Jetski Studios">
  <main class="not-found" id="main-content">
    <p class="kicker">Off the trail</p>
    <h1>That page drifted away.</h1>
    <p>The page you are looking for does not exist or has moved.</p>
    <p><a href="/">Back to projects</a></p>
  </main>
</SiteLayout>
<style>
  .not-found {
    max-width: var(--measure);
    margin-inline: auto;
    padding: 4rem 1.25rem 3rem;
  }

  .kicker {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ember);
    max-width: none;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5vw, 3rem);
  }
</style>
