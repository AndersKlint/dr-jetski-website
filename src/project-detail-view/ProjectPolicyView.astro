---
interface Props {
  projectName: string;
  projectHref: string;
}

const { projectName, projectHref } = Astro.props;
---
<main class="policy" id="main-content">
  <p class="return-link"><a href={projectHref}>Back to {projectName}</a></p>
  <article>
    <slot />
  </article>
</main>
<style>
  .policy {
    max-width: 68ch;
    margin-inline: auto;
    padding: 2rem 1.25rem 0;
    overflow-wrap: anywhere;
  }

  .return-link {
    margin: 0 0 2rem;
    font-size: 0.9rem;
  }

  article :global(h1) {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  article :global(h2) {
    margin-top: 2rem;
    font-size: 1.5rem;
    line-height: 1.25;
  }
</style>
