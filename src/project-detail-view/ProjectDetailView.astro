---
import type { Project, ProjectDownload } from '../projects/Project';
import { isTrialMaturity, maturityLabel, typeLabel } from '../projects/projectLabels';
import { prepareProjectColor } from '../projects/projectColor';
import ProjectDownloads from './ProjectDownloads.astro';
import ProjectGallery from './ProjectGallery.astro';
import HanScanAvailability from './HanScanAvailability.astro';

interface Props {
  project: Project;
  downloads: ProjectDownload[];
  isCompactMedia?: boolean;
  privacyHref?: string;
  termsHref?: string;
  isSimplified?: boolean;
  isDetailsSeparate?: boolean;
}

const { project, downloads, isCompactMedia = false, privacyHref, termsHref, isSimplified = false, isDetailsSeparate = false } = Astro.props;
const hasBody = project.body.trim().length > 0;
const { rawColor, readableAccent } = prepareProjectColor(project.projectColor);
---
<main class="detail" id="main-content" data-project={project.slug} style={`--project-color: ${rawColor}; --project-accent: ${readableAccent}`}>
  <ProjectGallery gallery={project.gallery} isCompact={isCompactMedia} />
  <header class="intro">
    <p class="kicker">
      <span class="type">{typeLabel(project.projectType)}</span>
      <span class="maturity" data-trial={isTrialMaturity(project.releaseMaturity)}>
        {maturityLabel(project.releaseMaturity)}
      </span>
      {!isSimplified && project.supportedPlatforms.length > 0 && (
        <span class="platforms">{project.supportedPlatforms.join(' · ')}</span>
      )}
    </p>
    <h1 class="title">{project.displayName}</h1>
    <p class="description">{project.description}</p>
    {!isSimplified && <p class="availability">{project.publicationNote ?? project.availability.message}</p>}
  </header>
  <slot name="before-downloads" />
  {project.slug === 'hanscan' ? (
    <HanScanAvailability links={project.links}><slot /></HanScanAvailability>
  ) : <ProjectDownloads
    downloads={downloads}
    availabilityMessage={project.availability.message}
    publicationNote={project.publicationNote}
    links={project.links}
    isSimplified={isSimplified}
  >
    {isSimplified && !isDetailsSeparate && hasBody && (
      <section class="download-details" aria-label="Installation">
        <slot />
      </section>
    )}
  </ProjectDownloads>}
  {(!isSimplified || isDetailsSeparate) && hasBody && (
    <section class:list={['body', { 'is-separate-details': isDetailsSeparate }]} aria-label="Project details">
      <slot />
    </section>
  )}
  <slot name="after-details" />
  {privacyHref && <p class="policy-link"><a href={privacyHref}>Privacy policy</a></p>}
  {termsHref && <p class="policy-link"><a href={termsHref}>Terms of service</a></p>}
</main>
<style>
  .detail {
    max-width: var(--measure);
    margin-inline: auto;
    padding: 2rem 1.25rem 0;
  }

  .detail[data-project='waytoclip'] {
    --project-headline-color: hsl(from var(--project-color) h s calc(l + 25));
  }

  .intro {
    margin-top: 2.5rem;
    max-width: 62ch;
  }

  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.85rem;
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    max-width: none;
  }

  .type {
    color: var(--project-accent);
  }

  .maturity {
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-secondary);
  }

  .maturity[data-trial='true'] {
    border-color: var(--project-color);
    color: var(--project-accent);
    font-weight: 700;
  }

  .platforms {
    color: var(--text-secondary);
    text-transform: none;
    letter-spacing: normal;
  }

  .title {
    overflow-wrap: anywhere;
    margin: 0 0 0.85rem;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1.06;
  }

  .description {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.18rem);
    line-height: 1.7;
    white-space: pre-line;
  }

  .availability {
    margin: 1.25rem 0 0;
    font-size: 0.875rem;
    color: var(--text-secondary);
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .body {
    margin-top: 2.5rem;
    max-width: 62ch;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
    line-height: 1.75;
  }

  .download-details {
    margin-top: 1.5rem;
    max-width: 62ch;
    line-height: 1.75;
  }

  .download-details :global(h3) {
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }

  .download-details :global(h4) {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  .download-details :global(p) {
    margin: 0;
  }

  .download-details :global(p + p) {
    margin-top: 1rem;
  }

  .download-details :global(p > strong) {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .download-details :global(pre),
  .is-separate-details :global(pre) {
    margin: 0.75rem 0 1rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .body :global(h2) {
    font-size: clamp(1.35rem, 3vw, 1.65rem);
    letter-spacing: -0.025em;
  }

  .body :global(h3) {
    font-size: 1.15rem;
  }

  .body :global(a),
  .policy-link a {
    color: var(--project-accent);
  }

  .body :global(a:hover),
  .policy-link a:hover {
    color: var(--text-primary);
  }

  .body :global(a:focus-visible),
  .policy-link a:focus-visible {
    outline-color: var(--project-accent);
  }

  .policy-link {
    margin-top: 2rem;
    font-size: 0.9rem;
  }

  .body :global(ul) {
    padding-left: 1.25rem;
  }

  .body :global(li + li) {
    margin-top: 0.35rem;
  }
</style>
