---
import type { Project } from "../projects/Project";
import MediaPreview from "../media/MediaPreview.astro";
import FeatureCaption from "../media/FeatureCaption.astro";
import {
  isTrialMaturity,
  maturityLabel,
  typeLabel,
} from "../projects/projectLabels";

interface Props {
  project: Project;
  isPriority?: boolean;
}

const { project, isPriority = false } = Astro.props;
---

<article class="card">
  <div
    class="card-media"
    data-has-controls={project.homepagePreview?.kind === "demo"}
  >
    <MediaPreview
      media={project.homepagePreview}
      crop={project.homepagePreview?.homepageCrop}
      isPriority={isPriority}
    />
  </div>
  <div class="card-body">
    <h3 class="card-title">
      <a
        href={project.href}
        aria-label={`View ${project.displayName} project page`}
        >{project.displayName}</a
      >
    </h3>
    <FeatureCaption
      text={project.homepagePreview?.featureOverlay?.text}
      title={project.displayName}
    />
    <p class="card-kicker">
      <span class="type">{typeLabel(project.projectType)}</span>
      <span
        class="maturity"
        data-trial={isTrialMaturity(project.releaseMaturity)}
      >
        {maturityLabel(project.releaseMaturity)}
      </span>
      {
        project.supportedPlatforms.length > 0 && (
          <span class="platforms">
            {project.supportedPlatforms.join(" · ")}
          </span>
        )
      }
    </p>
  </div>
</article>
<style>
  .card {
    position: relative;
    isolation: isolate;
    background: var(--charcoal-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    min-width: 0;
    transition: border-color 0.15s ease-in;
  }

  .card:hover,
  .card:focus-within {
    border-color: color-mix(in srgb, var(--text-secondary) 55%, var(--line));
  }

  .card-body {
    --feature-caption-size: 1.2rem;
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .card-media {
    position: relative;
    z-index: 0;
    --media-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
  }

  .card-media[data-has-controls="true"] {
    z-index: 2;
  }

  .card-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.6rem;
    margin: 1rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    max-width: none;
  }

  .type {
    color: var(--text-secondary);
  }

  .maturity {
    padding: 0.05rem 0.45rem;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--text-secondary);
  }

  .maturity[data-trial="true"] {
    background: color-mix(in srgb, var(--ember) 8%, transparent);
    border-color: color-mix(in srgb, var(--ember) 30%, transparent);
    color: var(--ember);
    font-weight: 600;
  }

  .platforms {
    color: var(--text-secondary);
    text-transform: none;
    letter-spacing: normal;
  }

  .card-title {
    margin: 0 0 0.5rem;
    font-size: 2.1rem;
    font-weight: 750;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
  }

  .card-title a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius);
  }

  .card-title a:focus-visible {
    outline: none;
  }

  .card-title a:focus-visible::after {
    outline: 3px solid var(--ember);
    outline-offset: 3px;
  }
</style>
