---
import type { Project } from '../projects/Project';
import StudioIdentity from '../banner/StudioIdentity.astro';
import AboutContact from '../about/AboutContact.astro';
import ProjectShowcase from './project-showcase/ProjectShowcase.astro';
import CompactProjectGrid from './CompactProjectGrid.astro';

interface Props {
  lead: Project[];
  secondary: Project[];
  compact: Project[];
}

const { lead, secondary, compact } = Astro.props;
const featured = [...lead, ...secondary];
---
<main id="main-content">
  <StudioIdentity />
  <ProjectShowcase projects={featured} />
  <CompactProjectGrid projects={compact} />
  <AboutContact />
</main>
