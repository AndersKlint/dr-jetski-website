---
import type { Project } from '../projects/Project';
import MediaPreview from '../media/MediaPreview.astro';
import { maturityLabel, typeLabel } from '../projects/projectLabels';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---
<section class="collection" aria-labelledby="collection-heading">
  <h2 class="section-heading" id="collection-heading">More projects</h2>
  <ul class="grid">
    {projects.map((project) => (
      <li>
        <article class="compact-card">
          <div class="compact-media">
            <MediaPreview media={project.homepagePreview} crop={project.homepagePreview?.homepageCrop} />
          </div>
          <div class="compact-body">
            <p class="compact-kicker">
              <span>{typeLabel(project.projectType)}</span>
              <span aria-label={`Release maturity: ${maturityLabel(project.releaseMaturity)}`}>
                {maturityLabel(project.releaseMaturity)}
              </span>
            </p>
            <h3 class="compact-title">
              <a class="compact-title-link" href={project.href}>{project.displayName}</a>
            </h3>
            <p class="compact-description">{project.description}</p>
            <p class="compact-note">{project.publicationNote ?? project.availability.message}</p>
            <p class="compact-action">
              <a href={project.href} aria-label={`View ${project.displayName} project page`}>
                View project <span aria-hidden="true">→</span>
              </a>
            </p>
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>
<style>
  .collection {
    max-width: var(--measure);
    margin-inline: auto;
    padding: 3.5rem 1.25rem 0;
  }

  .section-heading {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    margin: 0 0 1.25rem;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .grid > li {
    min-width: 0;
  }

  .compact-card {
    height: 100%;
    background: var(--charcoal-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.15s ease-in;
  }

  .compact-card:hover,
  .compact-card:focus-within {
    border-color: var(--ember);
  }

  .compact-body {
    padding: 1rem 1.1rem 1.25rem;
  }

  .compact-media {
    --media-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
  }

  .compact-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.6rem;
    margin: 0 0 0.45rem;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
    max-width: none;
  }

  .compact-title {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
  }

  .compact-title-link {
    color: inherit;
    text-decoration: none;
  }

  .compact-title-link:hover {
    color: var(--ember);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .compact-description {
    margin: 0 0 0.6rem;
    font-size: 0.92rem;
  }

  .compact-note {
    margin: 0;
    font-size: 0.83rem;
    color: var(--text-secondary);
    border-top: 1px solid var(--line);
    padding-top: 0.6rem;
  }

  .compact-action {
    margin: 0.6rem 0 0;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .compact-action a {
    color: var(--ember);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 2px;
  }

  .compact-action a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
