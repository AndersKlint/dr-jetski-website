---
import type { Project } from '../projects/Project';
import MediaPreview from '../media/MediaPreview.astro';
import FeatureCaption from '../media/FeatureCaption.astro';
import MobileAppPreview from './MobileAppPreview.astro';
import { isTrialMaturity, maturityLabel, typeLabel } from '../projects/projectLabels';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---
<section class="collection" aria-labelledby="collection-heading">
  <h2 class="section-heading" id="collection-heading">More projects</h2>
  <ul class="grid">
    {projects.map((project) => (
      <li>
        <article class="compact-card">
          <div class="compact-media" data-has-controls={project.homepagePreview?.kind === 'demo'}>
            {project.mobilePreview ? (
              <MobileAppPreview media={project.mobilePreview} />
            ) : (
              <MediaPreview media={project.homepagePreview} />
            )}
          </div>
          <div class="compact-body">
            <h3 class="compact-title">
              <a href={project.href} aria-label={`View ${project.displayName} project page`}>{project.displayName}</a>
            </h3>
            <FeatureCaption
              text={project.homepagePreview?.featureOverlay?.text}
              title={project.displayName}
            />
            <p class="compact-kicker">
              <span>{typeLabel(project.projectType)}</span>
              <span class="maturity" data-trial={isTrialMaturity(project.releaseMaturity)} aria-label={`Release maturity: ${maturityLabel(project.releaseMaturity)}`}>
                {maturityLabel(project.releaseMaturity)}
              </span>
            </p>
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>
<style>
  .collection {
    max-width: var(--measure);
    margin-inline: auto;
    padding: 3.5rem 1.25rem 0;
  }

  .section-heading {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    margin: 0 0 1.25rem;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .grid > li {
    min-width: 0;
  }

  .compact-card {
    position: relative;
    isolation: isolate;
    height: 100%;
    background: var(--charcoal-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.15s ease-in;
  }

  .compact-card:hover,
  .compact-card:focus-within {
    border-color: color-mix(in srgb, var(--text-secondary) 55%, var(--line));
  }

  .compact-body {
    --feature-caption-size: 1rem;
    padding: 1rem 1.1rem 1.25rem;
  }

  .compact-media {
    position: relative;
    z-index: 0;
    --media-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
  }

  .compact-media[data-has-controls='true'] {
    z-index: 2;
  }

  .compact-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.6rem;
    margin: 1rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    color: var(--text-secondary);
    max-width: none;
  }

  .maturity {
    padding: 0.05rem 0.45rem;
    border: 1px solid transparent;
    border-radius: 999px;
  }

  .maturity[data-trial='true'] {
    background: color-mix(in srgb, var(--ember) 8%, transparent);
    border-color: color-mix(in srgb, var(--ember) 30%, transparent);
    color: var(--ember);
    font-weight: 600;
  }

  .compact-title {
    margin: 0 0 0.4rem;
    font-size: 1.5rem;
    font-weight: 750;
  }

  .compact-title a {
    color: inherit;
    text-decoration: none;
  }

  .compact-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius);
  }

  .compact-title a:focus-visible {
    outline: none;
  }

  .compact-title a:focus-visible::after {
    outline: 3px solid var(--ember);
    outline-offset: 3px;
  }

  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
