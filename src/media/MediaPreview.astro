---
import type { GalleryItem, MediaCrop } from '../projects/Project';
import FeatureOverlay from './FeatureOverlay.astro';

interface Props {
  media?: GalleryItem;
  crop?: MediaCrop;
  isPriority?: boolean;
  isPlaybackManaged?: boolean;
  previewId?: string;
  class?: string;
}

const {
  media,
  crop,
  isPriority = false,
  isPlaybackManaged = false,
  previewId,
  class: className,
} = Astro.props;
const figureClass = ['media-preview', className, crop && media ? 'is-cropped' : undefined].filter(Boolean).join(' ');
const poster = media ? (media.kind === 'image' ? media.image : media.poster) : undefined;
const loading = isPriority ? 'eager' : 'lazy';
const fetchPriority = isPriority ? 'high' : undefined;
const dimensions = media?.kind === 'image' ? media.image : media;
const cropStyle = crop && dimensions
  ? `--crop-aspect: ${dimensions.width * (crop.xEnd - crop.xStart)} / ${dimensions.height * (crop.yEnd - crop.yStart)}; --crop-width: ${100 / (crop.xEnd - crop.xStart)}%; --crop-height: ${100 / (crop.yEnd - crop.yStart)}%; --crop-left: ${-100 * crop.xStart / (crop.xEnd - crop.xStart)}%; --crop-top: ${-100 * crop.yStart / (crop.yEnd - crop.yStart)}%`
  : undefined;
---
{media && poster && media.kind === 'image' && (
  <figure class={figureClass} style={cropStyle}>
    <div class="media-clip">
      <img
        src={poster.src}
        srcset={poster.srcSet}
        sizes={poster.sizes}
        width={poster.width}
        height={poster.height}
        alt={media.alt}
        decoding="async"
        loading={loading}
        fetchpriority={fetchPriority}
      />
    </div>
    {media.featureOverlay && <FeatureOverlay overlay={media.featureOverlay} />}
    {media.isPlaceholder && <figcaption class="placeholder-label">Placeholder preview</figcaption>}
  </figure>
)}
{media && poster && media.kind === 'preview' && (
  <figure
    class={`${figureClass} has-loop`}
    style={cropStyle}
    data-auto-preview
    data-preview-managed={isPlaybackManaged ? 'true' : undefined}
    data-preview-id={previewId}
  >
    <div class="media-clip">
      <img
        src={poster.src}
        srcset={poster.srcSet}
        sizes={poster.sizes}
        width={poster.width}
        height={poster.height}
        alt={media.alt}
        decoding="async"
        loading={loading}
        fetchpriority={fetchPriority}
      />
      <video
        class="loop-video"
        data-preview-video
        data-src={media.src}
        width={media.width}
        height={media.height}
        muted
        playsinline
        loop
        preload="none"
        disablepictureinpicture
        aria-label={media.alt}
      />
    </div>
    {media.featureOverlay && <FeatureOverlay overlay={media.featureOverlay} />}
    {media.isPlaceholder && <figcaption class="placeholder-label">Placeholder preview</figcaption>}
  </figure>
)}
{media && poster && media.kind === 'demo' && (
  <figure class={`${figureClass} has-demo`} style={cropStyle}>
    <div class="media-clip">
      <video
        class="demo-video"
        controls
        preload="none"
        poster={poster.src}
        src={media.src}
        width={media.width}
        height={media.height}
        playsinline
        muted={!media.hasAudio || undefined}
        aria-label={media.alt}
      >
        {media.alt}
      </video>
    </div>
    {media.featureOverlay && <FeatureOverlay overlay={media.featureOverlay} />}
    {media.isPlaceholder && <figcaption class="placeholder-label">Placeholder preview</figcaption>}
  </figure>
)}
{(!media || !poster) && (
  <div class={figureClass} aria-label="Preview not available">
    <span class="empty-label" aria-hidden="true">Preview not available</span>
  </div>
)}
<script>
  import { initPreviewPlayback } from './previewPlayback.client';
  initPreviewPlayback();
</script>
<style>
  .media-preview {
    margin: 0;
    min-width: 0;
    position: relative;
  }

  .media-preview img {
    display: block;
    width: 100%;
    height: auto;
  }

  .media-clip {
    position: relative;
    overflow: hidden;
    border-radius: var(--media-radius, 0);
  }

  .has-loop .loop-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
  }

  .has-loop[data-playing='true'] .loop-video {
    opacity: 1;
  }

  .has-demo .demo-video {
    display: block;
    width: 100%;
    height: auto;
  }

  .placeholder-label {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    margin: 0;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--charcoal-deep);
    color: var(--text-primary);
    border: 1px solid var(--line);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .media-preview.is-cropped {
    aspect-ratio: var(--crop-aspect);
  }

  .is-cropped > .media-clip {
    width: 100%;
    height: 100%;
  }

  .media-preview.is-cropped > .media-clip > img,
  .media-preview.is-cropped > .media-clip > video {
    position: absolute;
    inset: auto;
    left: var(--crop-left);
    top: var(--crop-top);
    width: var(--crop-width);
    height: var(--crop-height);
    max-width: none;
  }

  .empty-label {
    display: block;
    padding: 2rem 1rem;
    text-align: center;
    color: var(--text-secondary);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
  }
</style>
