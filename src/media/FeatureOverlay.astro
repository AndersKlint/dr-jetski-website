---
import type { FeatureOverlay } from "../projects/Project";
import "./featureOverlay.css";

interface Props {
  overlay: FeatureOverlay;
}

const { overlay } = Astro.props;
const direction = overlay.y <= 0.5 ? "column" : "column-reverse";
const style = `--feature-overlay-y: ${overlay.y}; --feature-overlay-direction: ${direction}; --feature-overlay-offset-x: ${overlay.offset.x}px; --feature-overlay-offset-y: ${overlay.offset.y}px${overlay.highlightColor === undefined ? "" : `; --feature-overlay-highlight-color: ${overlay.highlightColor}`}`;
---

<div
  class="feature-overlay"
  data-feature-overlay
  data-style={overlay.style}
  style={style}
>
  <div class="feature-overlay-positioner">
    <p class="feature-overlay-banner">{overlay.text}</p>
  </div>
</div>
