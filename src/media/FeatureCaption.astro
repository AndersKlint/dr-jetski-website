---
interface Props {
  text?: string;
  title: string;
}

const { text, title } = Astro.props;
const normalizeText = (value: string) => value.trim().replace(/\s+/g, ' ').toLowerCase();
const normalizedText = text ? normalizeText(text) : '';
const shouldShowCaption = normalizedText.length > 0
  && normalizedText !== normalizeText(title);
---
{shouldShowCaption && <p class="feature-caption">{text}</p>}
<style>
  .feature-caption {
    margin: 0 0 0.85rem;
    color: var(--text-secondary);
    font-size: var(--feature-caption-size, 1.2rem);
    font-weight: 500;
    line-height: 1.4;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
</style>
