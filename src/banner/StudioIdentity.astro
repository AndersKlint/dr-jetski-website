<div class="identity">
  <svg class="wake" viewBox="0 0 320 72" aria-hidden="true" focusable="false">
    <path d="M4 18 C 60 10, 110 26, 170 18 S 280 12, 316 20" />
    <path d="M4 38 C 70 30, 120 46, 185 36 S 275 32, 316 40" />
    <path d="M40 58 C 110 50, 170 64, 240 56 S 290 54, 312 58" />
  </svg>
  <h1 class="wordmark">Dr. Jetski <span class="wordmark-accent">Studios</span></h1>
  <p class="tagline">Independent apps, audio tools, and developer utilities.</p>
</div>
<style>
  .identity {
    position: relative;
    max-width: var(--measure);
    margin-inline: auto;
    padding: 2rem 1.25rem 0.5rem;
  }

  .wake {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 4.5rem;
    opacity: 0.35;
    pointer-events: none;
  }

  .wake path {
    fill: none;
    stroke: var(--wake);
    stroke-width: 1.5;
  }

  .wordmark {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.02em;
    max-width: none;
  }

  .wordmark-accent {
    color: var(--ember);
    font-weight: 400;
    font-style: italic;
  }

  .tagline {
    position: relative;
    margin: 0.35rem 0 0;
    color: var(--cream-dim);
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    max-width: none;
  }
</style>
