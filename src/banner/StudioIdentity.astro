---
import { fullLogoSrc } from "./studioBrandAssets";
---
<div class="identity">
  <h1 class="banner">
    <img
      class="logo"
      src={fullLogoSrc}
      alt="Dr. Jetski Studios"
      width={1600}
      height={540}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </h1>
  <p class="tagline">Independent apps, audio tools, and developer utilities.</p>
</div>
<style>
  .identity {
    max-width: var(--measure);
    margin-inline: auto;
    padding: 1.5rem 1.25rem 0.5rem;
  }

  .banner {
    margin: 0;
  }

  .logo {
    display: block;
    width: 100%;
    max-width: 48rem;
    height: auto;
    margin-inline: auto;
  }

  .tagline {
    margin: 0.35rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    max-width: none;
  }
</style>
