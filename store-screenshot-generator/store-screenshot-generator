#!/usr/bin/env node
import { readFile, mkdir, stat } from 'node:fs/promises';
import { dirname, resolve, basename, extname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { parseArgs } from 'node:util';
import { parseDocument } from 'yaml';
import { chromium } from 'playwright-core';
import { parseMediaPresentation, mediaSourceBasename } from '../src/projects/mediaPresentation.ts';

const scriptDirectory = dirname(fileURLToPath(import.meta.url));
const root = resolve(scriptDirectory, '..');

async function main() {
  const { values } = parseArgs({ options: {
    'project-name': { type: 'string' },
    'background-color': { type: 'string' },
    'highlight-color': { type: 'string' },
    'output-dir': { type: 'string' },
    padding: { type: 'string' },
    'phone-frame': { type: 'boolean', default: false },
    help: { type: 'boolean' },
  }, allowPositionals: false });
  if (values.help) {
    console.log(`Usage: ./store-screenshot-generator/store-screenshot-generator --project-name <slug> [options]

  --project-name <slug>       Required stable project slug
  --background-color <hex>    Six hex digits, optionally prefixed with #; default transparent
  --highlight-color <hex>     Six hex digits, optionally prefixed with #; default site ember
  --output-dir <directory>    Output directory relative to invocation cwd
  --padding <percent>        Minimum image/phone-edge short-edge margin per side; 0 <= percent < 50, default 8
  --phone-frame              Add the silver 9:20 SVG phone frame; default false
  --help                     Show this help

Default output: store-screenshot-generator/output/<slug>/<original-basename>.png
Exports images in media.yaml gallery order, using original sources and normal media captions.
PNG: 1440×2560 portrait/square sources, 2560×1440 landscape sources.
Transparent by default; use --background-color 211e1b for opaque RGB Google Play exports.
Transparent outputs are generic assets, not Google Play-compliant screenshots.
Full source image is centered with at least 8% short-edge padding by default.
With --phone-frame, padding measures the outer phone edges; screen corners are rounded and the camera overlays the image.
Screenshots fit inside the fixed 9:20 screen with black padding when their aspect ratio differs.
Captions follow the image and may overflow its padding or clip at the canvas edge.
Example: ./store-screenshot-generator/store-screenshot-generator --project-name hanscan --padding 2.5
Matching outputs are overwritten; unrelated files are retained.
Requires installed Chrome, or CHROME_PATH pointing to its executable.`);
    return;
  }
  const slug = values['project-name'];
  if (!slug || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
    throw new Error('--project-name must be a stable lowercase, hyphen-separated project slug');
  }
  const color = values['background-color'];
  if (color !== undefined && !/^#?[0-9a-fA-F]{6}$/.test(color)) {
    throw new Error('--background-color must contain exactly six hex digits, optionally prefixed with #');
  }
  const highlightColor = values['highlight-color'];
  if (highlightColor !== undefined && !/^#?[0-9a-fA-F]{6}$/.test(highlightColor)) {
    throw new Error('--highlight-color must contain exactly six hex digits, optionally prefixed with #');
  }
  if (values['output-dir'] === '') throw new Error('--output-dir must not be empty');
  const paddingInput = values.padding === undefined ? '8' : values.padding.trim();
  const paddingPercentage = Number(paddingInput);
  if (!paddingInput || !Number.isFinite(paddingPercentage) || paddingPercentage < 0 || paddingPercentage >= 50) {
    throw new Error('--padding must be a finite number greater than or equal to 0 and less than 50');
  }
  const outputDirectory = values['output-dir'] === undefined
    ? resolve(scriptDirectory, 'output', slug) : resolve(values['output-dir']);
  const projectDirectory = resolve(root, 'src/content/projects', slug);
  const indexPath = resolve(projectDirectory, 'index.md');
  const markdown = await readFile(indexPath, 'utf8');
  const frontmatter = markdown.match(/^\uFEFF?---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/);
  if (!frontmatter) throw new Error(`${indexPath}: missing YAML frontmatter`);
  const document = parseDocument(frontmatter[1], { uniqueKeys: true });
  if (document.errors.length) throw new Error(`${indexPath}: ${document.errors.map(error => error.message).join('; ')}`);
  const data = document.toJS();
  if (!data || data.slug !== slug) throw new Error(`${indexPath}: slug must match "${slug}"`);
  const sidecarPath = resolve(projectDirectory, 'media.yaml');
  let sidecar = '';
  try {
    sidecar = await readFile(sidecarPath, 'utf8');
  } catch (error) {
    if (error.code !== 'ENOENT') throw error;
  }
  const presentation = parseMediaPresentation(sidecar, sidecarPath);
  const gallery = presentation.gallery;
  if (presentation.preview && !gallery.some(item => mediaSourceBasename(item.media) === presentation.preview.mediaSource)) {
    throw new Error(`${sidecarPath}: preview must match an existing gallery source`);
  }
  const outputs = new Set();
  const images = [];
  for (const item of gallery.filter(item => item.kind === 'image')) {
    const source = resolve(projectDirectory, item.media);
    const filename = `${basename(source, extname(source))}.png`;
    if (outputs.has(filename.toLowerCase())) throw new Error(`Colliding output basename: ${filename}`);
    outputs.add(filename.toLowerCase());
    if (!(await stat(source)).isFile()) throw new Error(`Image source is not a file: ${source}`);
    const mime = { '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.webp': 'image/webp', '.svg': 'image/svg+xml', '.avif': 'image/avif' }[extname(source).toLowerCase()];
    if (!mime) throw new Error(`Unsupported image source: ${source}`);
    images.push({ filename, source, dataUrl: `data:${mime};base64,${(await readFile(source)).toString('base64')}`,
      overlay: item.featureOverlay });
  }
  if (!images.length) {
    console.log(`No gallery images to export for ${slug}.`);
    return;
  }
  const overlayCss = await readFile(resolve(root, 'src/media/featureOverlay.css'), 'utf8');
  const phoneFrameSvg = values['phone-frame']
    ? await readFile(resolve(scriptDirectory, 'phone-frame-9-20.svg'), 'utf8') : undefined;
  const globalCss = await readFile(resolve(root, 'src/site/global.css'), 'utf8');
  const tokens = ['font-body', 'text-primary', 'ember'].map(name => {
    const match = globalCss.match(new RegExp(`--${name}:\\s*([^;]+);`));
    if (!match) throw new Error(`Missing site token --${name}`);
    return `--${name}:${match[1]};`;
  }).join('');
  const fontDirectory = resolve(root, 'node_modules/@fontsource-variable/inter');
  let fontCss = await readFile(resolve(fontDirectory, 'index.css'), 'utf8');
  for (const match of [...fontCss.matchAll(/url\(([^)]+)\)/g)]) {
    const font = await readFile(resolve(fontDirectory, match[1]));
    fontCss = fontCss.replace(match[0], `url(data:font/woff2;base64,${font.toString('base64')})`);
  }
  const browser = await chromium.launch(process.env.CHROME_PATH
    ? { executablePath: process.env.CHROME_PATH } : { channel: 'chrome' });
  try {
    await mkdir(outputDirectory, { recursive: true });
    for (const image of images) {
      const measuringPage = await browser.newPage();
      const dimensions = await measuringPage.evaluate(async dataUrl => {
        const image = new Image();
        image.src = dataUrl;
        await image.decode();
        return { width: image.naturalWidth, height: image.naturalHeight };
      }, image.dataUrl);
      await measuringPage.close();
      const canvas = dimensions.width > dimensions.height
        ? { width: 2560, height: 1440 } : { width: 1440, height: 2560 };
      const context = await browser.newContext({ deviceScaleFactor: 1, viewport: canvas });
      try {
        const page = await context.newPage();
        await page.setContent('<!doctype html><html><head><meta charset="utf-8"></head><body><div id="composition"><img></div></body></html>');
        await page.addStyleTag({ content: `:root{${tokens}${highlightColor ? `--ember:#${highlightColor.replace(/^#/, '')};` : ''}} ${fontCss}
          *,*::before,*::after{box-sizing:border-box}
          body{margin:0;background:${color ? `#${color.replace(/^#/, '')}` : 'transparent'};font-family:var(--font-body);line-height:1.6}
          #composition{position:absolute;left:0;top:0;width:360px;height:${360 * dimensions.height / dimensions.width}px}
          #composition>img{display:block;width:100%;height:100%;border-radius:min(8px,${360 * dimensions.height / dimensions.width / 20}px)}
          #phone-frame{position:absolute;z-index:1;pointer-events:none}
          #phone-frame>svg{display:block;transform-origin:top left}
          #phone-screen{position:absolute;background:#000;overflow:hidden}
          #phone-screen>img{position:absolute;display:block}
          ${overlayCss}` });
        const phoneBounds = await page.evaluate(async ({ dataUrl, overlay, phoneFrameSvg, dimensions }) => {
          const composition = document.querySelector('#composition');
          const image = composition.querySelector('img');
          image.src = dataUrl;
          await image.decode();
          const imageWidth = 360, imageHeight = 360 * dimensions.height / dimensions.width;
          let bounds = { x: 0, y: 0, width: imageWidth, height: imageHeight };
          if (phoneFrameSvg) {
            const svg = new DOMParser().parseFromString(phoneFrameSvg, 'image/svg+xml').documentElement;
            const screen = svg.querySelector('#screen-opening');
            const screenX = screen.x.baseVal.value, screenY = screen.y.baseVal.value;
            const screenWidth = screen.width.baseVal.value, screenHeight = screen.height.baseVal.value;
            const isLandscape = dimensions.width > dimensions.height;
            const frameWidth = svg.viewBox.baseVal.width, frameHeight = svg.viewBox.baseVal.height;
            const displayScreenWidth = isLandscape ? screenHeight : screenWidth;
            const displayScreenHeight = isLandscape ? screenWidth : screenHeight;
            const frameScale = Math.max(imageWidth / displayScreenWidth, imageHeight / displayScreenHeight);
            const screenLeft = (imageWidth - displayScreenWidth * frameScale) / 2;
            const screenTop = (imageHeight - displayScreenHeight * frameScale) / 2;
            const screenContainer = document.createElement('div');
            screenContainer.id = 'phone-screen';
            screenContainer.style.left = `${screenLeft}px`;
            screenContainer.style.top = `${screenTop}px`;
            screenContainer.style.width = `${displayScreenWidth * frameScale}px`;
            screenContainer.style.height = `${displayScreenHeight * frameScale}px`;
            screenContainer.style.borderRadius = `${screen.rx.baseVal.value * frameScale}px`;
            image.style.width = `${imageWidth}px`;
            image.style.height = `${imageHeight}px`;
            image.style.left = `${-screenLeft}px`;
            image.style.top = `${-screenTop}px`;
            screenContainer.append(image);
            composition.append(screenContainer);
            bounds = isLandscape
              ? { x: screenLeft - screenY * frameScale, y: screenTop - (frameWidth - screenX - screenWidth) * frameScale,
                  width: frameHeight * frameScale, height: frameWidth * frameScale }
              : { x: screenLeft - screenX * frameScale, y: screenTop - screenY * frameScale,
                  width: frameWidth * frameScale, height: frameHeight * frameScale };
            const frame = document.createElement('div');
            frame.id = 'phone-frame';
            frame.style.left = `${bounds.x}px`;
            frame.style.top = `${bounds.y}px`;
            svg.style.transform = isLandscape
              ? `translateY(${frameWidth * frameScale}px) rotate(-90deg) scale(${frameScale})`
              : `scale(${frameScale})`;
            frame.append(svg);
            composition.append(frame);
          }
          if (overlay) {
            const wrapper = document.createElement('div');
            wrapper.className = 'feature-overlay';
            wrapper.dataset.style = overlay.style;
            wrapper.style.setProperty('--feature-overlay-y', String(overlay.y));
            wrapper.style.setProperty('--feature-overlay-direction', overlay.y <= 0.5 ? 'column' : 'column-reverse');
            wrapper.style.setProperty('--feature-overlay-offset-x', `${overlay.offset.x}px`);
            wrapper.style.setProperty('--feature-overlay-offset-y', `${overlay.offset.y}px`);
            const positioner = document.createElement('div');
            positioner.className = 'feature-overlay-positioner';
            const banner = document.createElement('p');
            banner.className = 'feature-overlay-banner';
            banner.textContent = overlay.text;
            positioner.append(banner);
            wrapper.append(positioner);
            composition.append(wrapper);
          }
          await document.fonts.ready;
          return bounds;
        }, { ...image, phoneFrameSvg, dimensions });
        await page.evaluate(({ canvas, paddingPercentage, phoneBounds }) => {
          const composition = document.querySelector('#composition');
          const padding = Math.min(canvas.width, canvas.height) * paddingPercentage / 100;
          const scale = Math.min((canvas.width - 2 * padding) / phoneBounds.width, (canvas.height - 2 * padding) / phoneBounds.height);
          composition.style.left = `${(canvas.width - phoneBounds.width * scale) / 2 - phoneBounds.x * scale}px`;
          composition.style.top = `${(canvas.height - phoneBounds.height * scale) / 2 - phoneBounds.y * scale}px`;
          composition.style.transformOrigin = 'top left';
          composition.style.transform = `scale(${scale})`;
        }, { canvas, paddingPercentage, phoneBounds });
        const outputPath = resolve(outputDirectory, image.filename);
        await page.screenshot({ path: outputPath, type: 'png', omitBackground: color === undefined,
          clip: { x: 0, y: 0, ...canvas }, scale: 'device' });
        console.log(outputPath);
      } finally {
        await context.close();
      }
    }
  } finally {
    await browser.close();
  }
}

main().catch(error => {
  console.error(`store-screenshot-generator: ${error.message}`);
  process.exitCode = 1;
});
