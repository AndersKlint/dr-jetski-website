#!/usr/bin/env node
import { readFile, mkdir, stat } from 'node:fs/promises';
import { dirname, resolve, basename, extname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { parseArgs } from 'node:util';
import { parseDocument } from 'yaml';
import { chromium } from 'playwright-core';
import { parseMediaPresentation, mediaSourceBasename } from '../src/projects/mediaPresentation.ts';

const scriptDirectory = dirname(fileURLToPath(import.meta.url));
const root = resolve(scriptDirectory, '..');

async function loadImageDataUrl(source) {
  if (!(await stat(source)).isFile()) throw new Error(`Image source is not a file: ${source}`);
  const mime = { '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.webp': 'image/webp', '.svg': 'image/svg+xml', '.avif': 'image/avif' }[extname(source).toLowerCase()];
  if (!mime) throw new Error(`Unsupported image source: ${source}`);
  return `data:${mime};base64,${(await readFile(source)).toString('base64')}`;
}

async function main() {
  const { values } = parseArgs({ options: {
    'project-name': { type: 'string' },
    device: { type: 'string', default: 'phone' },
    'background-color': { type: 'string' },
    'background-image': { type: 'string' },
    'highlight-color': { type: 'string' },
    'image-dir': { type: 'string' },
    'output-dir': { type: 'string' },
    'text-offset': { type: 'string' },
    'crop-status-bar': { type: 'string' },
    padding: { type: 'string' },
    'no-padding': { type: 'boolean', default: false },
    'no-text-overlay': { type: 'boolean', default: false },
    'phone-frame': { type: 'boolean', default: false },
    'stylized-frame': { type: 'boolean', default: false },
    'stylized-text': { type: 'boolean', default: false },
    help: { type: 'boolean' },
  }, allowPositionals: false });
  if (values.help) {
    console.log(`Usage: ./store-screenshot-generator/store-screenshot-generator --project-name <slug> [options]

  --project-name <slug>       Required stable project slug
  --device <phone|tablet>    Output device preset; default phone; tablet is always 3840×2160 landscape
  --background-color <hex>    Six hex digits, optionally prefixed with #; default transparent
  --background-image <path>   Fill the canvas with a local image using centered cover sizing
  --highlight-color <hex>     Override YAML accent; six hex digits, optionally prefixed with #; fallback site ember
  --image-dir <directory>     Alternate image folder with the same filenames; relative to invocation cwd
  --output-dir <directory>    Output directory relative to invocation cwd
  --text-offset <x,y>         Override every caption's YAML text_offset in CSS pixels
  --crop-status-bar <pixels>  Remove this many source-image pixels from the top; non-negative integer, default 0
  --padding <percent>        Minimum image/frame-edge short-edge margin per side; 0 <= percent < 50, default 8
  --no-padding               Set the minimum margin to zero; overrides --padding
  --no-text-overlay          Omit caption text bubbles from every exported image
  --phone-frame              Add the silver 9:20 SVG phone frame; default false
  --stylized-frame           Round screenshot corners and add a strong drop shadow, without a border
  --stylized-text            Replace caption bubbles with bold white headings above fitted screenshots
  --help                     Show this help

Default output: store-screenshot-generator/output/<slug>/<original-basename>.png
Exports images in media.yaml gallery order, using original sources and normal media captions.
With --image-dir, use alternate images and their dimensions; project YAML and captions stay the same.
Phone PNG: 1440×2560 portrait/square images, 2560×1440 landscape images, using dimensions after cropping.
Tablet PNG: fixed 3840×2160 landscape, with tablet-scaled corners, shadows, and headings; images retain their aspect ratio.
Use a 3840×2160 background image for tablet exports to fill the canvas exactly.
--crop-status-bar applies to every image before sizing, rounding, shadows, frames, and captions; source files stay intact.
Transparent by default; use --background-color 211e1b for opaque RGB Google Play exports.
--background-image resolves from invocation cwd and sits above the background color, behind screenshots and text.
Transparent outputs are generic assets, not Google Play-compliant screenshots.
The image remaining after any top crop is centered with at least 8% short-edge padding by default.
With --no-padding, aspect-ratio differences can still leave space on two sides; no additional crop-to-fill is applied.
With --phone-frame, padding measures the outer phone edges; screen corners are rounded and the camera overlays the image.
With --stylized-frame, screenshots keep their natural aspect ratio with rounded corners and a strong shadow, without a border.
Padding measures the screenshot itself, excluding its shadow.
Choose either --phone-frame or --stylized-frame, not both. Shadows may clip with small or zero padding.
With --phone-frame, screenshots fit inside the fixed 9:20 opening with black padding when their aspect ratio differs.
Captions follow the image and may overflow its padding or clip at the canvas edge.
--stylized-text uses each image's normal media.yaml text, preserving line breaks and wrapping to fit.
Headings reserve space above the full screenshot; uncaptioned images keep their usual layout.
--no-text-overlay hides bubbles only; it does not hide stylized headings. Caption offsets and accents do not apply to headings.
Example: ./store-screenshot-generator/store-screenshot-generator --project-name hanscan --padding 2.5
Clean transparent export: ./store-screenshot-generator/store-screenshot-generator --project-name hanscan --no-padding --no-text-overlay
Matching outputs are overwritten; unrelated files are retained.
Requires installed Chrome, or CHROME_PATH pointing to its executable.`);
    return;
  }
  const slug = values['project-name'];
  if (!slug || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
    throw new Error('--project-name must be a stable lowercase, hyphen-separated project slug');
  }
  const device = values.device;
  if (device !== 'phone' && device !== 'tablet') {
    throw new Error('--device must be phone or tablet');
  }
  const isTablet = device === 'tablet';
  const color = values['background-color'];
  if (color !== undefined && !/^#?[0-9a-fA-F]{6}$/.test(color)) {
    throw new Error('--background-color must contain exactly six hex digits, optionally prefixed with #');
  }
  const highlightColor = values['highlight-color'];
  if (highlightColor !== undefined && !/^#?[0-9a-fA-F]{6}$/.test(highlightColor)) {
    throw new Error('--highlight-color must contain exactly six hex digits, optionally prefixed with #');
  }
  if (values['image-dir'] === '') throw new Error('--image-dir must not be empty');
  if (values['output-dir'] === '') throw new Error('--output-dir must not be empty');
  if (values['background-image'] !== undefined && !values['background-image'].trim()) {
    throw new Error('--background-image must not be empty');
  }
  if (values['phone-frame'] && values['stylized-frame']) {
    throw new Error('--phone-frame and --stylized-frame cannot be used together');
  }
  let textOffset;
  if (values['text-offset'] !== undefined) {
    const coordinates = values['text-offset'].split(',').map(coordinate => coordinate.trim());
    if (coordinates.length !== 2 || coordinates.some(coordinate => !coordinate || !Number.isFinite(Number(coordinate)))) {
      throw new Error('--text-offset must contain two finite numbers separated by a comma, e.g. --text-offset=-20,10');
    }
    textOffset = { x: Number(coordinates[0]), y: Number(coordinates[1]) };
  }
  const paddingInput = values.padding === undefined ? '8' : values.padding.trim();
  const requestedPaddingPercentage = Number(paddingInput);
  if (!paddingInput || !Number.isFinite(requestedPaddingPercentage) || requestedPaddingPercentage < 0 || requestedPaddingPercentage >= 50) {
    throw new Error('--padding must be a finite number greater than or equal to 0 and less than 50');
  }
  const paddingPercentage = values['no-padding'] ? 0 : requestedPaddingPercentage;
  const cropInput = values['crop-status-bar'] === undefined ? '0' : values['crop-status-bar'].trim();
  const cropStatusBar = Number(cropInput);
  if (!cropInput || !Number.isSafeInteger(cropStatusBar) || cropStatusBar < 0) {
    throw new Error('--crop-status-bar must be a non-negative integer in source-image pixels');
  }
  const outputDirectory = values['output-dir'] === undefined
    ? resolve(scriptDirectory, 'output', slug) : resolve(values['output-dir']);
  const projectDirectory = resolve(root, 'src/content/projects', slug);
  const imageDirectory = values['image-dir'] === undefined
    ? projectDirectory : resolve(values['image-dir']);
  const backgroundDataUrl = values['background-image'] === undefined
    ? undefined : await loadImageDataUrl(resolve(values['background-image']));
  const indexPath = resolve(projectDirectory, 'index.md');
  const markdown = await readFile(indexPath, 'utf8');
  const frontmatter = markdown.match(/^\uFEFF?---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/);
  if (!frontmatter) throw new Error(`${indexPath}: missing YAML frontmatter`);
  const document = parseDocument(frontmatter[1], { uniqueKeys: true });
  if (document.errors.length) throw new Error(`${indexPath}: ${document.errors.map(error => error.message).join('; ')}`);
  const data = document.toJS();
  if (!data || data.slug !== slug) throw new Error(`${indexPath}: slug must match "${slug}"`);
  const sidecarPath = resolve(projectDirectory, 'media.yaml');
  let sidecar = '';
  try {
    sidecar = await readFile(sidecarPath, 'utf8');
  } catch (error) {
    if (error.code !== 'ENOENT') throw error;
  }
  const presentation = parseMediaPresentation(sidecar, sidecarPath);
  const gallery = presentation.gallery;
  if (presentation.preview && !gallery.some(item => mediaSourceBasename(item.media) === presentation.preview.mediaSource)) {
    throw new Error(`${sidecarPath}: preview must match an existing gallery source`);
  }
  const outputs = new Set();
  const images = [];
  for (const item of gallery.filter(item => item.kind === 'image')) {
    const source = resolve(imageDirectory, item.media);
    const filename = `${basename(source, extname(source))}.png`;
    if (outputs.has(filename.toLowerCase())) throw new Error(`Colliding output basename: ${filename}`);
    outputs.add(filename.toLowerCase());
    images.push({ filename, source, dataUrl: await loadImageDataUrl(source),
      heading: values['stylized-text'] ? item.featureOverlay?.text : undefined,
      overlay: !values['stylized-text'] && !values['no-text-overlay'] && item.featureOverlay ? {
        ...item.featureOverlay,
        offset: textOffset ?? item.featureOverlay.offset,
        highlightColor: highlightColor === undefined
          ? item.featureOverlay.highlightColor : `#${highlightColor.replace(/^#/, '')}`,
      } : undefined });
  }
  if (!images.length) {
    console.log(`No gallery images to export for ${slug}.`);
    return;
  }
  const overlayCss = await readFile(resolve(root, 'src/media/featureOverlay.css'), 'utf8');
  const frameSvg = values['phone-frame']
    ? await readFile(resolve(scriptDirectory, 'phone-frame-9-20.svg'), 'utf8') : undefined;
  const stylizedSvg = values['stylized-frame']
    ? await readFile(resolve(scriptDirectory, 'stylized-frame.svg'), 'utf8') : undefined;
  const globalCss = await readFile(resolve(root, 'src/site/global.css'), 'utf8');
  const tokens = ['font-body', 'text-primary', 'ember'].map(name => {
    const match = globalCss.match(new RegExp(`--${name}:\\s*([^;]+);`));
    if (!match) throw new Error(`Missing site token --${name}`);
    return `--${name}:${match[1]};`;
  }).join('');
  const fontDirectory = resolve(root, 'node_modules/@fontsource-variable/inter');
  let fontCss = await readFile(resolve(fontDirectory, 'index.css'), 'utf8');
  for (const match of [...fontCss.matchAll(/url\(([^)]+)\)/g)]) {
    const font = await readFile(resolve(fontDirectory, match[1]));
    fontCss = fontCss.replace(match[0], `url(data:font/woff2;base64,${font.toString('base64')})`);
  }
  const browser = await chromium.launch(process.env.CHROME_PATH
    ? { executablePath: process.env.CHROME_PATH } : { channel: 'chrome' });
  try {
    await mkdir(outputDirectory, { recursive: true });
    for (const image of images) {
      const measuringPage = await browser.newPage();
      const { dimensions, dataUrl } = await measuringPage.evaluate(async ({ dataUrl, cropStatusBar, source }) => {
        const image = new Image();
        image.src = dataUrl;
        await image.decode();
        if (cropStatusBar >= image.naturalHeight) {
          throw new Error(`${source}: --crop-status-bar (${cropStatusBar}) must be less than the image height (${image.naturalHeight})`);
        }
        const dimensions = { width: image.naturalWidth, height: image.naturalHeight - cropStatusBar };
        if (cropStatusBar === 0) return { dimensions, dataUrl };
        const croppedImage = document.createElement('canvas');
        croppedImage.width = dimensions.width;
        croppedImage.height = dimensions.height;
        croppedImage.getContext('2d').drawImage(image, 0, cropStatusBar, dimensions.width, dimensions.height,
          0, 0, dimensions.width, dimensions.height);
        return { dimensions, dataUrl: croppedImage.toDataURL('image/png') };
      }, { dataUrl: image.dataUrl, cropStatusBar, source: image.source });
      await measuringPage.close();
      const canvas = isTablet ? { width: 3840, height: 2160 }
        : dimensions.width > dimensions.height ? { width: 2560, height: 1440 } : { width: 1440, height: 2560 };
      const imageShortEdge = Math.min(360, 360 * dimensions.height / dimensions.width);
      const imageCornerRadius = isTablet ? imageShortEdge * 0.015 : Math.min(8, 360 * dimensions.height / dimensions.width / 20);
      const context = await browser.newContext({ deviceScaleFactor: 1, viewport: canvas });
      try {
        const page = await context.newPage();
        await page.setContent('<!doctype html><html><head><meta charset="utf-8"></head><body><div id="composition"><img></div></body></html>');
        await page.addStyleTag({ content: `:root{${tokens}} ${fontCss}
          *,*::before,*::after{box-sizing:border-box}
          body{margin:0;background:${color ? `#${color.replace(/^#/, '')}` : 'transparent'};font-family:var(--font-body);line-height:1.6}
          #background-image{position:fixed;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:0}
          #stylized-heading{position:absolute;z-index:2;margin:0;color:#fff;font-weight:900;line-height:1.05;letter-spacing:-0.035em;text-align:center;white-space:pre-line;text-wrap:balance;overflow-wrap:anywhere;text-shadow:0 3px 20px rgb(0 0 0 / 0.12)}
          #composition{position:absolute;z-index:1;left:0;top:0;width:360px;height:${360 * dimensions.height / dimensions.width}px}
          #composition>img{display:block;width:100%;height:100%;border-radius:${imageCornerRadius}px}
          #frame{position:absolute;z-index:1;pointer-events:none}
          #frame>svg{display:block;transform-origin:top left}
          #frame-screen{position:absolute;background:#000;overflow:hidden}
          #frame-screen>img{position:absolute;display:block}
          ${overlayCss}` });
        const compositionBounds = await page.evaluate(async ({ dataUrl, overlay, frameSvg, stylizedSvg, dimensions, backgroundDataUrl, isTablet }) => {
          if (backgroundDataUrl) {
            const background = document.createElement('img');
            background.id = 'background-image';
            background.src = backgroundDataUrl;
            await background.decode();
            document.body.prepend(background);
          }
          const composition = document.querySelector('#composition');
          const image = composition.querySelector('img');
          image.src = dataUrl;
          await image.decode();
          const imageWidth = 360, imageHeight = 360 * dimensions.height / dimensions.width;
          let bounds = { x: 0, y: 0, width: imageWidth, height: imageHeight };
          if (stylizedSvg) {
            const svg = new DOMParser().parseFromString(stylizedSvg, 'image/svg+xml').documentElement;
            const imageShortEdge = Math.min(imageWidth, imageHeight);
            const cornerRadius = isTablet ? imageShortEdge * 0.035
              : Math.min(svg.querySelector('rect').rx.baseVal.value, imageWidth / 12, imageHeight / 12);
            if (isTablet) {
              const shadow = svg.querySelector('feDropShadow');
              const effectScale = imageShortEdge / svg.viewBox.baseVal.width;
              for (const attribute of ['dx', 'dy', 'stdDeviation']) {
                shadow.setAttribute(attribute, String(Number(shadow.getAttribute(attribute)) * effectScale));
              }
            }
            svg.replaceChildren(svg.querySelector('defs'));
            svg.setAttribute('width', '0');
            svg.setAttribute('height', '0');
            svg.style.position = 'absolute';
            composition.append(svg);
            image.style.borderRadius = `${cornerRadius}px`;
            image.style.filter = 'url(#screenshot-shadow)';
          }
          if (frameSvg) {
            const svg = new DOMParser().parseFromString(frameSvg, 'image/svg+xml').documentElement;
            const screen = svg.querySelector('#screen-opening');
            const screenX = screen.x.baseVal.value, screenY = screen.y.baseVal.value;
            const screenWidth = screen.width.baseVal.value, screenHeight = screen.height.baseVal.value;
            const isLandscape = dimensions.width > dimensions.height;
            const frameWidth = svg.viewBox.baseVal.width, frameHeight = svg.viewBox.baseVal.height;
            const displayScreenWidth = isLandscape ? screenHeight : screenWidth;
            const displayScreenHeight = isLandscape ? screenWidth : screenHeight;
            const frameScale = Math.max(imageWidth / displayScreenWidth, imageHeight / displayScreenHeight);
            const screenLeft = (imageWidth - displayScreenWidth * frameScale) / 2;
            const screenTop = (imageHeight - displayScreenHeight * frameScale) / 2;
            const screenContainer = document.createElement('div');
            screenContainer.id = 'frame-screen';
            screenContainer.style.left = `${screenLeft}px`;
            screenContainer.style.top = `${screenTop}px`;
            screenContainer.style.width = `${displayScreenWidth * frameScale}px`;
            screenContainer.style.height = `${displayScreenHeight * frameScale}px`;
            screenContainer.style.borderRadius = `${screen.rx.baseVal.value * frameScale}px`;
            image.style.width = `${imageWidth}px`;
            image.style.height = `${imageHeight}px`;
            image.style.left = `${-screenLeft}px`;
            image.style.top = `${-screenTop}px`;
            screenContainer.append(image);
            composition.append(screenContainer);
            bounds = isLandscape
              ? { x: screenLeft - screenY * frameScale, y: screenTop - (frameWidth - screenX - screenWidth) * frameScale,
                  width: frameHeight * frameScale, height: frameWidth * frameScale }
              : { x: screenLeft - screenX * frameScale, y: screenTop - screenY * frameScale,
                  width: frameWidth * frameScale, height: frameHeight * frameScale };
            const frame = document.createElement('div');
            frame.id = 'frame';
            frame.style.left = `${bounds.x}px`;
            frame.style.top = `${bounds.y}px`;
            svg.style.transform = isLandscape
              ? `translateY(${frameWidth * frameScale}px) rotate(-90deg) scale(${frameScale})`
              : `scale(${frameScale})`;
            frame.append(svg);
            composition.append(frame);
          }
          if (overlay) {
            const wrapper = document.createElement('div');
            wrapper.className = 'feature-overlay';
            wrapper.dataset.style = overlay.style;
            wrapper.dataset.side = overlay.side;
            wrapper.style.setProperty('--feature-overlay-y', String(overlay.y));
            wrapper.style.setProperty('--feature-overlay-direction', overlay.y <= 0.5 ? 'column' : 'column-reverse');
            wrapper.style.setProperty('--feature-overlay-offset-x', `${overlay.offset.x}px`);
            wrapper.style.setProperty('--feature-overlay-offset-y', `${overlay.offset.y}px`);
            if (overlay.highlightColor !== undefined) {
              wrapper.style.setProperty('--feature-overlay-highlight-color', overlay.highlightColor);
            }
            const positioner = document.createElement('div');
            positioner.className = 'feature-overlay-positioner';
            const banner = document.createElement('p');
            banner.className = 'feature-overlay-banner';
            banner.textContent = overlay.text;
            positioner.append(banner);
            wrapper.append(positioner);
            composition.append(wrapper);
          }
          await document.fonts.ready;
          return bounds;
        }, { ...image, dataUrl, frameSvg, stylizedSvg, dimensions, backgroundDataUrl, isTablet });
        await page.evaluate(async ({ canvas, paddingPercentage, compositionBounds, headingText, isTablet }) => {
          const composition = document.querySelector('#composition');
          const shortEdge = Math.min(canvas.width, canvas.height);
          const padding = shortEdge * paddingPercentage / 100;
          let contentTop = padding;
          if (headingText) {
            const heading = document.createElement('h1');
            heading.id = 'stylized-heading';
            heading.textContent = headingText;
            const headingInset = shortEdge * 0.06;
            const headingTop = shortEdge * (isTablet ? 0.04 : 0.045);
            const headingGap = shortEdge * (isTablet ? 0.035 : 0.04);
            const maximumHeadingHeight = canvas.height * (isTablet ? 0.2 : 0.25);
            let fontSize = Math.floor(shortEdge * (isTablet ? 0.075 : 0.095));
            heading.style.left = `${headingInset}px`;
            heading.style.top = `${headingTop}px`;
            heading.style.width = `${canvas.width - 2 * headingInset}px`;
            heading.style.fontSize = `${fontSize}px`;
            document.body.append(heading);
            await document.fonts.ready;
            while (fontSize > 1 && (heading.getBoundingClientRect().height > maximumHeadingHeight || heading.scrollWidth > heading.clientWidth)) {
              heading.style.fontSize = `${--fontSize}px`;
            }
            if (heading.getBoundingClientRect().height > maximumHeadingHeight || heading.scrollWidth > heading.clientWidth) {
              throw new Error('Caption is too long to fit the stylized heading area');
            }
            contentTop = Math.max(padding, headingTop + heading.getBoundingClientRect().height + headingGap);
          }
          const availableHeight = canvas.height - contentTop - padding;
          const scale = Math.min((canvas.width - 2 * padding) / compositionBounds.width, availableHeight / compositionBounds.height);
          composition.style.left = `${(canvas.width - compositionBounds.width * scale) / 2 - compositionBounds.x * scale}px`;
          composition.style.top = `${contentTop + (availableHeight - compositionBounds.height * scale) / 2 - compositionBounds.y * scale}px`;
          composition.style.transformOrigin = 'top left';
          composition.style.transform = `scale(${scale})`;
        }, { canvas, paddingPercentage, compositionBounds, headingText: image.heading, isTablet });
        const outputPath = resolve(outputDirectory, image.filename);
        await page.screenshot({ path: outputPath, type: 'png', omitBackground: color === undefined,
          clip: { x: 0, y: 0, ...canvas }, scale: 'device' });
        console.log(outputPath);
      } finally {
        await context.close();
      }
    }
  } finally {
    await browser.close();
  }
}

main().catch(error => {
  console.error(`store-screenshot-generator: ${error.message}`);
  process.exitCode = 1;
});
